<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>[sbz] Fridge</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="sbz_SingleWallFridge"]/building</xpath>
					<value>
						<supportsWallAttachments>true</supportsWallAttachments>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="sbz_DoubleWallFridge"]/building</xpath>
					<value>
						<supportsWallAttachments>true</supportsWallAttachments>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>


