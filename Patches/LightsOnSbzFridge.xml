<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationSequence" MayRequire="sbz.NeatStorageFridge">
				<operations>
					<li Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName="sbz_SingleWallFridge"]/building</xpath>
						<value>
							<supportsWallAttachments>true</supportsWallAttachments>
						</value>
					</li>
					<li Class="PatchOperationAdd">
						<xpath>/Defs/ThingDef[defName="sbz_DoubleWallFridge"]/building</xpath>
						<value>
							<supportsWallAttachments>true</supportsWallAttachments>
						</value>
					</li>
				</operations>
			</li>
		</operations>
	</Operation>
</Patch>


